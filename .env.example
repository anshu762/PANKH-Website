# ==============================================================================
# PANKH POULTRY INTELLIGENCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env` and populate keys according to your environment.
# Note: In development or test mode, all external integrations gracefully simulate
# behavior if API keys are left blank.

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL (NEON WITH PGVECTOR)
# ------------------------------------------------------------------------------
# Direct connection string to Neon PostgreSQL database with pgvector extension enabled.
# Provides persistence for users, farms, batches, health logs, notifications, and embeddings.
# Get at: https://neon.tech
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS (AUTHENTICATION)
# ------------------------------------------------------------------------------
# Secret keys for signing and encrypting session JWTs (generate with `openssl rand -base64 32`).
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
AUTH_SECRET="your-32-character-random-secret-key-here"

# Canonical URL of the deployment (e.g. http://localhost:3000 or https://pankh.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Initial seed password for SUPER_ADMIN role (admin@pankh.app)
ADMIN_SEED_PASSWORD="PankhAdmin2026!"

# ------------------------------------------------------------------------------
# 3. AI / LLM CONFIGURATION (GOOGLE GEMINI - MINIMAL TOKEN COST)
# ------------------------------------------------------------------------------
# Option A: Direct Google Gemini API Key (Recommended: Free tier with 15 RPM, ₹0 / $0 bill)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Option B: OpenRouter API Gateway
# Configured to use Google Gemini 2.0 Flash (`google/gemini-2.0-flash-001`) by default
# for lightning-fast latency (~400ms) and ~97% lower cost than Claude 3.5 Sonnet.
# Get at: https://openrouter.ai/
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD SPEECH (VOICE INPUT & OUTPUT)
# ------------------------------------------------------------------------------
# Used for Punjabi (pa-IN) and Hindi (hi-IN) Speech-to-Text and Text-to-Speech fallback.
# Get at: https://console.cloud.google.com/apis/credentials (Enable Speech-to-Text & Text-to-Speech)
GOOGLE_CLOUD_API_KEY=""

# ------------------------------------------------------------------------------
# 5. OPENWEATHERMAP (MICROCLIMATE & SHED HEAT STRESS)
# ------------------------------------------------------------------------------
# Used by Pankh Sentinel to retrieve real-time outside temperature/humidity for the farm's
# GPS coordinates, compute Temperature-Humidity Index (THI), and detect heat stress risks.
# Cached with an in-memory 3-hour TTL.
# Get free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM (FARM GEOCODING & VET/LAB LOCATOR)
# ------------------------------------------------------------------------------
# Used in farm onboarding for village/district geocoding and Pankh Connect for distance calculation.
# Get at: https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# 7. WHATSAPP & NOTIFICATIONS (ZERO-COST DIRECT ENGINE)
# ------------------------------------------------------------------------------
# Pankh Connect & Sentinel use direct zero-cost WhatsApp Click-to-Chat (wa.me)
# and native in-app notifications. No third-party Twilio or Meta WABA accounts required.

# ------------------------------------------------------------------------------
# 8. CLOUDINARY MEDIA STORAGE (PHOTO & DIAGNOSTIC MEDIA ATTACHMENTS)
# ------------------------------------------------------------------------------
# Used for storing farmer diagnostic photos, shed images, and poultry health media.
# Sign up at: https://cloudinary.com/
# Get Cloud Name, API Key, and API Secret from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional single connection URL format:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

