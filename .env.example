# Database connection string for PostgreSQL (Neon) with pgvector extension enabled
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used to encrypt Auth.js / NextAuth v5 session tokens (generate using `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
AUTH_SECRET="your-32-character-random-secret-key-here"

# Canonical URL of the application for NextAuth callback handling
NEXTAUTH_URL="http://localhost:3000"

# Initial password for the seeded SUPER_ADMIN account (admin@pankh.app)
ADMIN_SEED_PASSWORD="PankhSuperAdmin2026!"

# OpenRouter API key for LLM queries in Pankh AI assistant
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenRouter Model identifier (e.g. anthropic/claude-3.5-sonnet, deepseek/deepseek-chat)
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Google Cloud API key for Speech-to-Text (STT) and Text-to-Speech (TTS) voice input
GOOGLE_CLOUD_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# OpenWeatherMap API key for hyper-local microclimate risk calculations in Pankh Sentinel
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# Google Maps Platform API key for geocoding farm coordinates and Vet/Lab locator distance calculation
GOOGLE_MAPS_API_KEY="AIzaSyYYYYYYYYYYYYYYYYYYYYYYYYYYYY"

# Twilio Account SID for sending SMS and WhatsApp disease alerts
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Twilio Auth Token for API request authorization
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"

# Twilio WhatsApp sender phone number in E.164 format (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Vercel Blob read-write token for storing farmer photo and audio uploads
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
